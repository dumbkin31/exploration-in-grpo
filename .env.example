# Copy to .env (git-ignored) and fill in. Sourced by configs/ada.env.sh if present.
# Needed for the gated GPQA dataset and for private HF repos.
HF_TOKEN=
# W&B: jobs on Ada log ONLINE from the compute nodes (they reach api.wandb.ai) under this entity/project;
# a node without internet falls back to offline, and scripts/wandb_sync.sh pushes those from your laptop.
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=mixed-cuts
