# Copy to .env (git-ignored) and fill in. Sourced by configs/ada.env.sh if present.
# Needed for the gated GPQA dataset and for private HF repos.
HF_TOKEN=
# W&B: read by jobs on Ada (offline runs record entity/project). Syncing runs from your laptop
# with scripts/wandb_sync.sh (the Ada login node cannot run wandb: glibc 2.17).
WANDB_API_KEY=
WANDB_ENTITY=
WANDB_PROJECT=mixed-cuts
